msgstr "Ellenőrizd ezt a kijelzőbemenetet: a játékmódját és a Dolby Vision beállítását."

msgctxt "#30213"
msgid "Set the display mode to 3840x2160 at 24 to 60 Hz in the display settings."
msgstr "Állítsd a kijelzőmódot 3840x2160-ra, 24–60 Hz-re a kijelzőbeállításokban."

msgctxt "#30214"
msgid "Choose the output for this video again with the button below, or in the player settings."
msgstr "Válaszd ki újra a kimenetet ehhez a videóhoz az alábbi gombbal, vagy a lejátszóbeállításokban."

msgctxt "#30215"
msgid "Turn on Adjust display refresh rate in the player settings."
msgstr "Kapcsold be a \"Kijelző képfrissítési frekvenciájának igazítása\" beállítást a lejátszóbeállításokban."

msgctxt "#30216"
msgid "Check the HDR setting of this TV input and the display settings of Hades."
msgstr "Ellenőrizd e kijelzőbemenet HDR beállítását és a Hades kijelzőbeállításait."

msgctxt "#30217"
msgid "Turn off Sync playback to display to send the sound untouched."
msgstr "Kapcsold ki a lejátszás szinkronizálását a kijelzőhöz, hogy a hang érintetlenül menjen ki."

msgctxt "#30218"
msgid "See the System page."
msgstr "Lásd a Rendszer oldalt."

msgctxt "#30219"
msgid "more notes: see the pages"
msgstr "további megjegyzések: lásd az oldalakat"

msgctxt "#30220"
msgid "Turn on Allow passthrough in the audio settings to send the sound untouched."
msgstr "Kapcsold be a hangtovábbítás engedélyezését a hangbeállításokban, hogy a hang érintetlenül menjen ki."

msgctxt "#30221"
msgid "Turn on passthrough for this format in the audio settings to send the sound untouched."
msgstr "Kapcsold be ennek a formátumnak a továbbítását a hangbeállításokban, hogy a hang érintetlenül menjen ki."

